{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "URL shortener portal — React + Vite frontend, Express API, MySQL storage",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
