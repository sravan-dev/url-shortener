# ---- Server ----
NODE_ENV=development
PORT=3000
# Public base URL used to build short links (no trailing slash).
# Leave empty to auto-detect from the incoming request.
BASE_URL=http://localhost:3000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=url_shortener

# ---- Admin login ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
